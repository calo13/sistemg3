* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# Preserve exported documents and bundled image/font assets byte for byte.
*.pdf binary
*.pptx binary
*.webm binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
